@echo off
rem SPDX-License-Identifier: MIT
rem Copyright (c) 2026 Jens Köhler
rem Assisted-by: Claude Code (Anthropic)
rem
rem Generated from packaging/launcher.cmd.in — do not edit the installed copy.
rem
rem The Windows counterpart of packaging/launcher.in, and it has one extra job.
rem A Debian package installs `md` where the distribution's interpreter already
rem looks; a Windows installer cannot, because the interpreter belongs to the
rem user and may not exist yet. So the payload sits beside this script and the
rem import path is set here, from `%~dp0` — the directory this file is in —
rem rather than assumed. `%~dp0` keeps its trailing backslash, hence `%~dp0.`.
rem
rem `python` unqualified, and that is the honest behaviour: the console follows
rem whichever Python is on PATH, the same one `pip install PySide6` would have
rem installed into. docs/WINDOWS.md says what to do when there is more than one.
setlocal
set "PYTHONPATH=%~dp0.;%PYTHONPATH%"

rem Windows 10 and 11 ship an *app execution alias* called python.exe that is
rem not Python: it opens the Microsoft Store and returns 9009. So "is python on
rem PATH" is not the question — the question is whether the thing on PATH runs,
rem and the only way to find out is to run it. A machine with no Python at all
rem reaches this line too, and the two deserve the same answer: a sentence,
rem rather than a Store page or a bare "'python' is not recognized".
python -c "import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)" >nul 2>&1
if errorlevel 1 (
  echo.
  echo   The training console needs Python 3.11 or newer, and this machine has
  echo   no usable "python" on PATH.
  echo.
  echo   Install one from https://www.python.org/downloads/ with "Add python.exe
  echo   to PATH" ticked, then:  python -m pip install PySide6
  echo.
  echo   The game itself needs none of this - it was installed alongside this
  echo   console and runs on its own.
  echo.
  pause
  exit /b 1
)

python -m @MD_LAUNCHER_MODULE@ %*
