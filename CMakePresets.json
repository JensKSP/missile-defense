{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (ASan+UBSan on Linux/macOS; plain Debug on MSVC)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MD_SANITIZE": "ON",
        "MD_VULKAN_VALIDATION": "ON",
        "MD_DEV_TOOLCHAIN": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "RelWithDebInfo, optimised + LTO (system compiler)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MD_LTO": "ON"
      }
    },
    {
      "name": "profile",
      "inherits": "base",
      "displayName": "-O3 + LTO, built for external sampling profilers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG",
        "MD_LTO": "ON",
        "MD_BUILD_APP": "OFF",
        "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer -g",
        "MD_DEV_TOOLCHAIN": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Coverage (core only)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MD_COVERAGE": "ON",
        "MD_BUILD_APP": "OFF",
        "MD_DEV_TOOLCHAIN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "profile",
      "configurePreset": "profile"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    }
  ]
}
