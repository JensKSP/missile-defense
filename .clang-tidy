# clang-tidy configuration for missile-defense.
# Strict: every enabled diagnostic is an error (WarningsAsErrors: '*').
# Run via: poe tidy  (lints core/src + app/*, from build/debug/compile_commands.json)
Checks: >
  clang-analyzer-*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  cppcoreguidelines-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-do-while,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -readability-uppercase-literal-suffix,
  -readability-redundant-member-init,
  -modernize-use-designated-initializers,
  -readability-function-cognitive-complexity,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-owning-memory

# Deliberately disabled, with rationale:
#  * magic-numbers / identifier-length / trailing-return-type / uppercase-suffix
#    / do-while / redundant-member-init / easily-swappable-parameters — stylistic
#    friction that hurts readability of game math and small value types.
#  * The rest are unavoidable in the Qt 6 + Vulkan + miniaudio client:
#    designated-initializers (Vulkan C structs + hot-path vertex PODs),
#    cognitive-complexity (the per-state renderer draw), pointer-arithmetic /
#    array decay / C-arrays (audio mixer, vertex buffers, push constants,
#    generated SPIR-V headers), owning-memory (Qt factory ownership handoff).

# Two checks added in clang-tidy 22 are *scoped* rather than switched off, so they
# keep working everywhere they are meaningful (see CheckOptions below):
#  * pro-bounds-avoid-unchecked-container-access — successor to
#    pro-bounds-constant-array-index. Excluded for the sequence containers this
#    codebase indexes directly (array, span, vector): every such index is already
#    bounded by a fixed capacity, a size() loop, or an explicit check, and the
#    alternative it suggests, `.at()`, throws — which the noexcept, exception-free
#    hot path forbids (DESIGN.md §9). Left enabled otherwise, so indexing a
#    container we do not currently use still has to justify itself.
#  * invalid-enum-default-initialization — ignored only for the Vulkan (`Vk*`) and
#    miniaudio (`ma_*`) C enums. Those structs *must* be zero-initialised before
#    their fields are filled in, and 0 is the documented "unset" state. It stays on
#    for our own enums, where a zero-value gap would be a genuine bug.

WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(core|bindings|app)/.*'
FormatStyle: file

CheckOptions:
  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access.ExcludeClasses: '::std::map;::std::unordered_map;::std::flat_map;::std::array;::std::span;::std::vector'
  bugprone-invalid-enum-default-initialization.IgnoredEnums: '::std::errc;::Vk.*;::ma_.*'
