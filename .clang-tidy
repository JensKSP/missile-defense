# clang-tidy configuration for the missile-defense project.
# Run via: poe tidy  (uses build/debug/compile_commands.json)
Checks: >
  clang-analyzer-*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  cppcoreguidelines-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-do-while

WarningsAsErrors: ''
HeaderFilterRegex: '.*/(core|bindings|app)/.*'
FormatStyle: file
