# Build output
/build/
/compile_commands.json

# Recorded runs (training artifacts)
/runs/

# glslangValidator's default output names. The build never writes these: it
# compiles app/shaders/quad.{vert,frag} into headers in the build tree, so a
# .spv beside the sources is always somebody having run the compiler by hand.
/app/*.spv
*.spv

# Capture outputs
/shot*.png
/clip*.mp4
/contact*.png

# Python
.venv/
venv/
# The compiled extension, copied beside the package for in-place dev/test use
/python/md/_md_native*.pyd
/python/md/_md_native*.so
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Local design-companion sessions
.superpowers/

# Coverage artifacts
*.profraw
*.profdata

# Packages
*.deb

# Type-checker caches
.mypy_cache/
