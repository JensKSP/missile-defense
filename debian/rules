#!/usr/bin/make -f
# Build with debhelper + the CMake buildsystem.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# The top-level CMakeLists nudges Linux builds to Clang whenever it finds one.
# That is right for development and wrong for a package: a .deb must be built
# with the distribution's own toolchain. A buildd has no clang for the nudge to
# find, so this changes nothing there — but it decides the build on any machine
# that does have one, which until now meant the package silently came out of a
# different compiler than Debian would use. It also failed: clang writes DWARF 5
# with a .debug_addr section, dh_dwz cannot read it, and the build died at the
# last step with 104/104 tests already passed. $CXX beats the nudge by design.
#
# The side effect is worth having on its own. Everything else — the Linux gate,
# macOS, Windows — is Clang, so this is the one build that compiles the tree with
# GCC, and the golden determinism test runs there against a second compiler.
#
# <print> (agent/, bench/) needs libstdc++ 14. Prefer the distribution's default
# compiler when it is new enough: g++ 15 on Ubuntu 26.04 and g++ 14 on Debian
# trixie. Ubuntu 24.04's default is 13, so debian/control installs g++-14 there
# instead. devscripts itself can still bring the default g++ into the container,
# so existence is not enough: ask dpkg to compare the compiler's actual version
# before choosing it, then fall back to the versioned executable.
export CXX := $(shell \
	if command -v g++ >/dev/null && \
	   dpkg --compare-versions "$$(g++ -dumpfullversion)" ge 14; then \
		command -v g++; \
	else \
		command -v g++-14; \
	fi)

%:
	dh $@ --buildsystem=cmake

# No -Werror in the package (new compilers must not break the archive build),
# no sanitizers/coverage, and the Qt+Vulkan app enabled.
# Where this distribution's Python expects a third-party package to live. Asked
# of the interpreter rather than hard-coded, because the answer moves between
# releases (and between Debian and Ubuntu) and a wrong guess installs a package
# nothing can import.
DIST_PACKAGES := $(shell py3versions -d -i) -c \
	"import sysconfig; print(sysconfig.get_path('purelib', 'deb_system'))"
MD_DIST_PACKAGES := $(shell $(DIST_PACKAGES))

# One source package, three binaries: the game (no Python at all), the Python
# bindings, and the training console. MD_INSTALL_PYTHON_PACKAGE is what puts the
# .py sources and the md-console / md-train launchers into the staging tree for
# the .install files to split; MD_BUILD_BINDINGS builds the extension beside them.
# The Python half is a build profile because one supported compatibility target
# cannot satisfy it: `python3-nanobind` reached Debian after Ubuntu 24.04 froze,
# so Noble cannot build the extension from archive packages. Building the *game*
# there is still worth proving, so `nopython` drops the two Python binaries and
# leaves the rest of the package exactly as it is. Ubuntu 26.04 and Debian
# trixie build all three packages with the profile unset.
NOPYTHON := $(filter pkg.missile-defense.nopython,$(DEB_BUILD_PROFILES))
ifeq ($(NOPYTHON),)
PYTHON_ARGS := \
		-DMD_BUILD_BINDINGS=ON \
		-DMD_INSTALL_PYTHON_PACKAGE=ON \
		-DMD_PYTHON_INSTALL_DIR=$(MD_DIST_PACKAGES)/md
else
PYTHON_ARGS := \
		-DMD_BUILD_BINDINGS=OFF \
		-DMD_INSTALL_PYTHON_PACKAGE=OFF
endif

override_dh_auto_configure:
	dh_auto_configure -- \
		-DMD_WERROR=OFF \
		-DMD_PEDANTIC=OFF \
		-DMD_SANITIZE=OFF \
		-DMD_COVERAGE=OFF \
		-DMD_BUILD_APP=ON \
		$(PYTHON_ARGS)

override_dh_auto_install:
	dh_auto_install
	# Licensing is covered by debian/copyright; drop the duplicate shipped file.
	rm -f debian/tmp/usr/share/doc/missile-defense/LICENSE
