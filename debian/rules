#!/usr/bin/make -f
# Build with debhelper + the CMake buildsystem.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# The top-level CMakeLists nudges Linux builds to Clang whenever it finds one.
# That is right for development and wrong for a package: a .deb must be built
# with the distribution's own toolchain. A buildd has no clang for the nudge to
# find, so this changes nothing there — but it decides the build on any machine
# that does have one, which until now meant the package silently came out of a
# different compiler than Debian would use. It also failed: clang writes DWARF 5
# with a .debug_addr section, dh_dwz cannot read it, and the build died at the
# last step with 104/104 tests already passed. $CXX beats the nudge by design.
#
# The side effect is worth having on its own. Everything else — the Linux gate,
# macOS, Windows — is Clang, so this is the one build that compiles the tree with
# GCC, and the golden determinism test runs there against a second compiler.
#
# g++-14 by preference: <print> (agent/, bench/) needs libstdc++ 14. Debian
# trixie's default g++ is already 14, so this picks the default there and changes
# nothing; Ubuntu 24.04's default is 13, where naming g++-14 explicitly is the
# difference between the same packaging building and not. debian/control declares
# that as an either/or so both distributions can satisfy it.
export CXX := $(shell command -v g++-14 || command -v g++)

%:
	dh $@ --buildsystem=cmake

# No -Werror in the package (new compilers must not break the archive build),
# no sanitizers/coverage, and the Qt+Vulkan app enabled.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DMD_WERROR=OFF \
		-DMD_PEDANTIC=OFF \
		-DMD_SANITIZE=OFF \
		-DMD_COVERAGE=OFF \
		-DMD_BUILD_APP=ON

override_dh_auto_install:
	dh_auto_install
	# Licensing is covered by debian/copyright; drop the duplicate shipped file.
	rm -f debian/missile-defense/usr/share/doc/missile-defense/LICENSE
